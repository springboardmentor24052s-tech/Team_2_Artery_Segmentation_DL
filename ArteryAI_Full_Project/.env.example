# ArteryAI Research Platform - Frontend Environment Configuration

# Base URL for the future backend API integration (provisional)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Toggle demo mock mode: 'true' uses frontend mock data and simulated workflows, 'false' directs requests to backend API
VITE_USE_MOCK=true

# Supported medical image formats for coronary angiography (comma-separated extensions)
VITE_SUPPORTED_IMAGE_FORMATS=.dcm,.png,.jpg,.jpeg,.tif,.tiff

# Maximum file size in megabytes for scan uploads
VITE_MAX_UPLOAD_SIZE_MB=50

# Enable calls to the Flask AI endpoint while retaining mock case management
VITE_AI_ENABLED=false
