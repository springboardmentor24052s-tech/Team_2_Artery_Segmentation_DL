# Change this to a long, random secret before deployment.
SECRET_KEY=replace-this-with-a-long-random-secret
# SQLite is used by default. For MySQL: mysql+pymysql://user:password@localhost/arteryai
# DATABASE_URL=sqlite:///arteryai_dev.db
# Absolute path is recommended for custom upload storage.
# UPLOAD_FOLDER=uploads
# Comma-separated exact frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
